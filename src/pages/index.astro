---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PostCard from '../components/PostCard.astro';
import Footer from '../components/Footer.astro';
import { getPublishedPosts, getCategories } from '../lib/supabase';

const [posts, categories] = await Promise.all([
  getPublishedPosts(12),
  getCategories(),
]);

const splitPosts = posts.slice(0, 2);
const gridPosts = posts.slice(2, 6);
const listPosts = posts.slice(6);
---

<BaseLayout title="TheChoiceList — รายการคัดสรรสินค้าเด็ดจากทั่วโลก">
  <Navbar />

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="editorial-title text-5xl font-bold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
            บล็อก
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
            อัปเดตข่าวสาร รายการคัดสรร รีวิวตรงไปตรงมา และดีลเด็ดจากทั่วเว็บ — ทุกอย่างที่คุณไม่ควรพลาด
          </p>
        </div>

        <div class="hero-search w-full max-w-sm shrink-0 lg:max-w-md" role="search">
          <label for="blog-search" class="sr-only">ค้นหาบทความ</label>
          <input
            id="blog-search"
            type="search"
            name="q"
            placeholder="ค้นหาบทความ..."
            class="hero-search-input"
            disabled
            aria-disabled="true"
            title="ฟีเจอร์ค้นหากำลังจะมาเร็วๆ นี้"
          />
          <span class="flex items-center px-4 text-slate-400" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </section>

  <CategoryFilter categories={categories} />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <h2 class="editorial-title mb-10 text-2xl font-bold uppercase tracking-wide text-slate-900 sm:text-3xl">
        ล่าสุด
      </h2>

      {
        posts.length > 0 ? (
          <>
            {splitPosts.length > 0 && (
              <div class="mb-14 grid gap-6 lg:grid-cols-2 lg:gap-8">
                {splitPosts[0] && <PostCard post={splitPosts[0]} variant="split-image" />}
                {splitPosts[1] && <PostCard post={splitPosts[1]} variant="split-dark" />}
              </div>
            )}

            {gridPosts.length > 0 && (
              <div class="mb-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
                {gridPosts.map((post) => (
                  <PostCard post={post} variant="default" />
                ))}
              </div>
            )}

            {listPosts.length > 0 && (
              <div class="mb-14 border-t border-slate-200">
                {listPosts.map((post) => (
                  <PostCard post={post} variant="compact" />
                ))}
              </div>
            )}

            <div class="text-center">
              <a
                href="/posts"
                class="inline-flex items-center justify-center border border-slate-900 bg-white px-8 py-3 text-xs font-bold uppercase tracking-widest text-slate-900 transition hover:bg-slate-950 hover:text-white"
              >
                ดูบทความเพิ่มเติม
              </a>
            </div>
          </>
        ) : (
          <div class="border border-dashed border-slate-300 bg-white p-12 text-center">
            <p class="text-slate-500">ยังไม่มีบทความที่เผยแพร่ — เริ่มสร้างจากแดชบอร์ดแอดมิน</p>
            <a href="/admin" class="mt-4 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
              ไปที่แอดมิน →
            </a>
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
