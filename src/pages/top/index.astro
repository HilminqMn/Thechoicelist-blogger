---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts } from '../../lib/supabase';

const allPosts = await getPublishedPosts(50);
const topPosts = [...allPosts]
  .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
  .slice(0, 6);

const splitPosts = topPosts.slice(0, 2);
const gridPosts = topPosts.slice(2);
---

<BaseLayout title="Top — TheChoiceList" description="บทความยอดนิยมและคัดสรรจาก TheChoiceList">
  <Navbar />

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <h1 class="editorial-title text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Top
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
        บทความคัดสรรยอดนิยม — รีวิวและลิสต์สินค้าที่ได้รับความนิยมสูงสุด
      </p>
    </div>
  </section>

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      {
        topPosts.length > 0 ? (
          <>
            {splitPosts.length > 0 && (
              <div class="mb-14 grid gap-6 lg:grid-cols-2 lg:gap-8">
                {splitPosts[0] && <PostCard post={splitPosts[0]} variant="split-image" />}
                {splitPosts[1] && <PostCard post={splitPosts[1]} variant="split-dark" />}
              </div>
            )}

            {gridPosts.length > 0 && (
              <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
                {gridPosts.map((post) => (
                  <PostCard post={post} variant="default" />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="border border-dashed border-slate-300 bg-white p-12 text-center">
            <p class="text-slate-500">ยังไม่มีบทความยอดนิยม</p>
            <a href="/" class="mt-4 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
              ← กลับหน้าแรก
            </a>
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
