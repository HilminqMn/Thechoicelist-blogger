---
import type { Post } from '../lib/types';
import { formatDateShort, estimateReadTime } from '../lib/supabase';

interface Props {
  post: Post;
  variant?: 'split-image' | 'split-dark' | 'default' | 'compact';
}

const { post, variant = 'default' } = Astro.props;
const readMins = estimateReadTime(post.content);
const categoryName = post.categories?.name;
---

{
  variant === 'split-image' ? (
    <article class="group">
      <a href={`/blog/${post.slug}`} class="block">
        <div class="relative mb-5 aspect-[4/3] overflow-hidden bg-slate-200 sm:aspect-[16/10]">
          {
            post.image_url ? (
              <img
                src={post.image_url}
                alt={post.title}
                class="card-image-bw h-full w-full object-cover"
                loading="eager"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-slate-200 text-slate-400">
                <span class="text-sm">ไม่มีรูปภาพ</span>
              </div>
            )
          }
          <div class="card-image-overlay" />
          {categoryName && <span class="category-pill">{categoryName}</span>}
        </div>
        <h2 class="editorial-title mb-1 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">
          {post.title}
        </h2>
        <div class="card-footer">
          {categoryName && <span>{categoryName}</span>}
          <time datetime={post.created_at}>{formatDateShort(post.created_at)}</time>
          <span>อ่าน ({readMins} นาที)</span>
          <span class="card-footer-arrow" aria-hidden="true">→</span>
        </div>
      </a>
    </article>
  ) : variant === 'split-dark' ? (
    <article class="group">
      <a
        href={`/blog/${post.slug}`}
        class="flex min-h-[320px] flex-col justify-end bg-slate-950 p-6 sm:min-h-[380px] sm:p-8 lg:min-h-[420px]"
      >
        {categoryName && <span class="editorial-tag mb-4 w-fit border-slate-700 bg-slate-800 text-slate-200">{categoryName}</span>}
        <h2 class="editorial-title mb-4 text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl">
          {post.title}
        </h2>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-white/20 pt-4 text-xs font-medium uppercase tracking-wide text-slate-400">
          {categoryName && <span>{categoryName}</span>}
          <time datetime={post.created_at}>{formatDateShort(post.created_at)}</time>
          <span>อ่าน ({readMins} นาที)</span>
          <span class="ml-auto text-lg text-white transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </div>
      </a>
    </article>
  ) : variant === 'compact' ? (
    <article class="group border-b border-slate-200 py-6 last:border-b-0">
      <a href={`/blog/${post.slug}`} class="flex gap-5 sm:gap-8">
        <div class="relative h-24 w-32 shrink-0 overflow-hidden bg-slate-200 sm:h-28 sm:w-40">
          {
            post.image_url && (
              <>
                <img
                  src={post.image_url}
                  alt={post.title}
                  class="card-image-bw h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="card-image-overlay" />
              </>
            )
          }
          {categoryName && <span class="category-pill category-pill-sm">{categoryName}</span>}
        </div>
        <div class="flex min-w-0 flex-1 flex-col justify-center">
          <h2 class="editorial-title mb-2 text-lg font-bold leading-snug text-slate-900 sm:text-xl">
            {post.title}
          </h2>
          <div class="card-footer mt-2 border-t-0 pt-0">
            {categoryName && <span>{categoryName}</span>}
            <time datetime={post.created_at}>{formatDateShort(post.created_at)}</time>
            <span>อ่าน ({readMins} นาที)</span>
            <span class="card-footer-arrow" aria-hidden="true">→</span>
          </div>
        </div>
      </a>
    </article>
  ) : (
    <article class="group">
      <a href={`/blog/${post.slug}`} class="block">
        <div class="relative mb-4 aspect-[4/3] overflow-hidden bg-slate-200">
          {
            post.image_url ? (
              <>
                <img
                  src={post.image_url}
                  alt={post.title}
                  class="card-image-bw h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="card-image-overlay" />
              </>
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-slate-200 text-slate-400">
                <span class="text-sm">ไม่มีรูปภาพ</span>
              </div>
            )
          }
          {categoryName && <span class="category-pill">{categoryName}</span>}
        </div>
        <h2 class="editorial-title mb-1 text-xl font-bold leading-snug text-slate-900">
          {post.title}
        </h2>
        <div class="card-footer">
          {categoryName && <span>{categoryName}</span>}
          <time datetime={post.created_at}>{formatDateShort(post.created_at)}</time>
          <span>อ่าน ({readMins} นาที)</span>
          <span class="card-footer-arrow" aria-hidden="true">→</span>
        </div>
      </a>
    </article>
  )
}
