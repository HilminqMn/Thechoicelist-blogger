---
import type { Category } from '../lib/types';

interface Props {
  categories: Category[];
  activeCategory?: string | null;
}

const { categories, activeCategory = null } = Astro.props;
const filterCols = categories.length + 1;
---

{
  categories.length > 0 && (
    <nav
      class="border-b border-slate-200 bg-slate-50"
      aria-label="หมวดหมู่บทความ"
    >
      <div
        class="category-filter-grid mx-auto grid max-w-7xl gap-1 px-4 py-3 sm:px-6 lg:px-8"
        style={`grid-template-columns: repeat(${filterCols}, minmax(0, 1fr))`}
      >
        <a
          href="/"
          class:list={[
            'category-filter-pill flex min-h-9 items-center justify-center border border-slate-300 bg-white px-2 py-2 text-center text-[10px] font-semibold uppercase leading-tight tracking-wider text-slate-600 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900 sm:min-h-10 sm:px-3 sm:text-xs',
            activeCategory === null && 'category-filter-pill-active border-slate-900 font-bold text-slate-900',
          ]}
        >
          บทความทั้งหมด
        </a>
        {
          categories.map((category) => (
            <a
              href={`/category/${category.slug}`}
              class:list={[
                'category-filter-pill flex min-h-9 items-center justify-center border border-slate-300 bg-white px-2 py-2 text-center text-[10px] font-semibold uppercase leading-tight tracking-wider text-slate-600 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900 sm:min-h-10 sm:px-3 sm:text-xs',
                activeCategory === category.slug && 'category-filter-pill-active border-slate-900 font-bold text-slate-900',
              ]}
            >
              {category.name}
            </a>
          ))
        }
      </div>
    </nav>
  )
}
