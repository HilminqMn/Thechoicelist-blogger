# URL โปรเจกต์ Supabase (Dashboard → Project Settings → API → Project URL)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key (Dashboard → Project Settings → API → anon public)
# ใช้ใน browser client สำหรับ OAuth และ RLS
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (Dashboard → Project Settings → API → service_role)
# ใช้เฉพาะ server-side / Edge Functions — ห้ามเปิดเผยใน client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
